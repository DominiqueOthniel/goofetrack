# Supabase : Project Settings -> API
#
# Ces variables restent cote serveur (pas de prefixe NEXT_PUBLIC) : seules les
# routes API interrogent la base, la cle ne doit jamais partir dans le
# navigateur.
SUPABASE_URL=https://votre-projet.supabase.co

# Cle "service_role" et non "anon" : le schema active RLS sans politique, ce qui
# bloque tout acces direct depuis un navigateur.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-service-role
